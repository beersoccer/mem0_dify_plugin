# Root development env template (no secrets)

# Core Dify settings
DIFY_BASE_URL="https://your-dify-host.example.com/v1"
DIFY_API_KEY="your-dify-api-key"
DIFY_USER_IDS="test_user_a,test_user_b"
DIFY_APP_ID="your-app-id"

# Optional time window for specific tests/scripts
TEST_START_TIME="2026-01-01T00:00:00Z"
TEST_END_TIME="2026-01-02T00:00:00Z"

# Optional profile flags
TEST_PROFILE="local"
ALLOW_LOCALHOST_DIFY="1"
REQUIRE_DIFY_NETWORK="0"
