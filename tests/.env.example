# Test env template (no real secrets)
#
# Usage:
# 1) Copy to tests/.env.local or tests/.env.remote
# 2) Set TEST_PROFILE in that file (local/remote/ci)
# 3) Fill all placeholders before running real-environment tests

# ---------- Execution strategy ----------
# local profile:
# TEST_PROFILE="local"
# ALLOW_LOCALHOST_DIFY="1"
# REQUIRE_DIFY_NETWORK="0"
#
# remote profile:
# TEST_PROFILE="remote"
# ALLOW_LOCALHOST_DIFY="0"
# REQUIRE_DIFY_NETWORK="1"
# ci profile (usually in tests/.env.remote):
# TEST_PROFILE="ci"
# ALLOW_LOCALHOST_DIFY="0"
# REQUIRE_DIFY_NETWORK="1"
# CI usually injects env vars directly; this file is optional in CI.
TEST_PROFILE="<local|remote|ci>"
ALLOW_LOCALHOST_DIFY="<0|1>"
REQUIRE_DIFY_NETWORK="<0|1>"

# ---------- Dify ----------
DIFY_BASE_URL="https://<your-dify-host>/v1"
DIFY_API_KEY="<your-dify-api-key>"
DIFY_APP_ID="<your-app-id>"

# ---------- Timeouts ----------
DIFY_HTTP_TIMEOUT="20"
DIFY_POLL_INTERVAL="2"
DIFY_WORKFLOW_MAX_WAIT="120"
DIFY_STALL_TIMEOUT="30"

# ---------- Mem0 (required for e2e/acceptance) ----------
MEM0_LLM_CONFIG='{"provider":"<provider>","config":{"model":"<model>","api_key":"<api-key>","azure_endpoint":"https://<resource>.openai.azure.com/"}}'
MEM0_EMBEDDER_CONFIG='{"provider":"<provider>","config":{"model":"<embed-model>","api_key":"<api-key>","azure_endpoint":"https://<resource>.openai.azure.com/"}}'
MEM0_VECTOR_DB_CONFIG='{"provider":"pgvector","config":{"connection_string":"postgresql://<user>:<password>@<host>:5432/<db>?sslmode=disable"}}'
MEM0_GRAPH_DB_CONFIG='{"provider":"none","config":{}}'
MEM0_RERANKER_CONFIG='{"provider":"none","config":{}}'

# ---------- Cleanup ----------
# Required by --cleanup force-all
# Delimiters: comma, semicolon, or spaces
# Example: DIFY_CLEANUP_USERS="test_user_a,test_user_b"
DIFY_CLEANUP_USERS=""
