# performance/.env template (no secrets)

DIFY_API_KEY="your-dify-api-key"
DIFY_BASE_URL="https://your-dify-host.example.com/v1"
DIFY_ENDPOINT="/chat-messages"
DIFY_QUERY="Hello, this is a performance test prompt."
DIFY_USER_COUNT="5"
DIFY_RESPONSE_MODE="streaming"
DIFY_MIN_TURNS="3"
DIFY_MAX_TURNS="5"
